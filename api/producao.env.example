# MODELO DE PREPARAÇÃO: não habilita produção no servidor atual.
# Configure os valores no painel de segredos/ambiente da hospedagem.
# Não copie credenciais para o Git, chat, prints ou linha de comando.
NODE_ENV=production
PUBLIC_ORIGIN=https://PREENCHER_DOMINIO
PORT=3000
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Endereços/CIDRs exatos, confirmados pelo provedor; nunca true, 1 ou 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=
# Caminho absoluto FORA do diretório substituído no deploy.
UPLOADS_DIR=
# Somente yes depois de testar reinício e novo deploy com uma imagem real.
MEDIA_PERSISTENCE_VERIFIED=no
